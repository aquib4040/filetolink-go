# ==============================================================================
# FileToLink Go (.env.example)
# Configuration template with detailed explanations for all environment variables.
# Copy this file to .env and fill in your values. Never commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API & Bot Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Your Telegram App API ID and API HASH obtained from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Primary Telegram Bot Token from @BotFather (handles bot commands and UI interactions)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram User ID of the bot owner (authorized for admin commands like /addpaid, /auth_gc)
OWNER_ID=123456789

# ------------------------------------------------------------------------------
# 2. Storage Channel (REQUIRED)
# ------------------------------------------------------------------------------
# Telegram Channel ID (starting with -100) where incoming files are forwarded.
# Bot must be added as an Administrator with post/forward permissions.
BIN_CHANNEL=-1001234567890

# Optional: Channel ID used for reply reels / random media previews (leave 0 if unused)
REEL_CHANNEL_ID=0

# ------------------------------------------------------------------------------
# 3. Server, Network & Domain Configuration
# ------------------------------------------------------------------------------
# Fully Qualified Domain Name of your deployed instance (e.g. your-app.herokuapp.com or stream.domain.com)
FQDN=localhost:8080

# Port on which the Go HTTP streaming and REST API server listens
PORT=8080

# Set to "True" if using SSL/TLS (HTTPS) behind Cloudflare or Heroku router, else "False"
HAS_SSL=True

# Network bind interface (0.0.0.0 listens on all IPv4 interfaces)
BIND_ADDRESS=0.0.0.0

# Optional: Permanent Domain Redirect URL.
# If set (e.g. https://watch.mybrand.com), links will point to this permanent domain,
# which performs a 302 redirect to the streaming FQDN while preserving the encrypted token.
PERMANENT_REDIRECT_URL=

# ------------------------------------------------------------------------------
# 4. Stateless Cryptography & Security (REQUIRED)
# ------------------------------------------------------------------------------
# AES-256-GCM symmetric key (32 bytes Base64-encoded or raw string).
# This key encrypts file metadata (chat_id, msg_id, hash, filename, size) into compact tokens.
# Streaming links NEVER query the database to resolve files!
ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# Secret string used for internal signing and integrity verification
BOT_SIGNING_SECRET=change_this_to_a_random_secure_secret_token

# ------------------------------------------------------------------------------
# 5. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas cluster).
# Used for:
#  - Bandwidth metrics tracking (today, weekly, monthly, yearly, overall bytes transferred)
#  - User tracking (recording users who started the bot in DM)
#  - Dynamic Force-Sub channels (FSub)
#  - Authorized group chats (/auth_gc) and Paid subscription plans (/addpaid)
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 6. Streaming Engine Performance Settings
# ------------------------------------------------------------------------------
# Concurrency level for parallel 1 MiB chunk downloads from Telegram MTProto (default: 16)
DOWNLOAD_THREADS=16

# Directory path where MTProto session files are persisted for fast restarts
GOTD_DATA_PATH=./data/gotd

# Maximum number of files processed in a single /link batch command in groups
MAX_BATCH_FILES=20

# Allow bot to automatically process new files posted in channels (True/False)
CHANNEL=False

# Default PM mode (True = anyone can use bot in DM; False = requires paid plan or group use)
PM_MODE_DEFAULT=False

# ------------------------------------------------------------------------------
# 7. Multi-Bot Worker Pool (Recommended for High Throughput)
# ------------------------------------------------------------------------------
# Additional Telegram Bot Tokens to distribute MTProto download streams and bypass rate limits.
# Add as many as needed (MULTI_TOKEN1 to MULTI_TOKEN100).
# If any token is revoked or fails to authenticate, the Go server automatically detects it,
# marks it invalid in memory, and skips it without blocking or waiting.
MULTI_TOKEN1=1111111111:AAExampleToken1
MULTI_TOKEN2=2222222222:AAExampleToken2
MULTI_TOKEN3=3333333333:AAExampleToken3
